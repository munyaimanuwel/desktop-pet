{
  "name": "desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "A small AI-powered desktop pet that lives on your desktop while you work.",
  "main": "src/electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron\"",
    "electron:prod": "npm run build && cross-env NODE_ENV=production electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test \"src/pet/*.test.js\"",
    "pet": "node scripts/pet.js",
    "hooks:install": "node scripts/install-hooks.js"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "ai.petal.desktop-pet",
    "productName": "Desktop Pet",
    "files": [
      "out/**/*",
      "src/electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
